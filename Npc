-- ========== NPC DETECTION ==========
local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

local function rebuildNPCCache()
    local t = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then t[obj] = true end
    end
    npcCache = t
end

-- ========== HITBOX MODULE ==========
local function removeBox(part)
    local b = part:FindFirstChild("MBAA_HitboxVisual")
    if b then b:Destroy() end
end

local function addBox(part)
    local b = part:FindFirstChild("MBAA_HitboxVisual")
    if not b then
        b = Instance.new("BoxHandleAdornment")
        b.Name = "MBAA_HitboxVisual"
        b.Adornee = part
        b.AlwaysOnTop = true
        b.ZIndex = 5
        b.Parent = part
    end
    b.Size = part.Size
    b.Color3 = Config.HitboxVisualColor
    b.Transparency = 0.5
    return b
end

local function getHitboxPartNames()
    local names = {}
    if Config.HitboxHeadEnabled then names["Head"] = true end
    if Config.HitboxBodyEnabled then
        names["HumanoidRootPart"] = true
        names["UpperTorso"] = true
        names["Torso"] = true
    end
    return names
end

local function applyHitbox()
    if not Config.HitboxEnabled then
        if next(hitboxData) then
            for part, data in pairs(hitboxData) do
                if part and part.Parent then
                    part.Size = data.Size
                    part.Transparency = data.Transparency
                    part.CanCollide = data.CanCollide
                    removeBox(part)
                end
            end
            hitboxData = {}
        end
        return
    end

    local names = getHitboxPartNames()
    local active = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then
            for name in pairs(names) do
                local part = obj:FindFirstChild(name)
                if part and part:IsA("BasePart") then
                    active[part] = true
                    if not hitboxData[part] then
                        hitboxData[part] = {
                            Size = part.Size,
                            Transparency = part.Transparency,
                            CanCollide = part.CanCollide,
                        }
                    end
                    part.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                    part.Transparency = Config.HitboxTransparency
                    part.CanCollide = false
                    if Config.HitboxVisualize then
                        local box = addBox(part)
                        box.Size = part.Size
                        box.Color3 = Config.HitboxVisualColor
                    else
                        removeBox(part)
                    end
                end
            end
        end
    end

    for part, data in pairs(hitboxData) do
        if not active[part] or not part.Parent then
            if part and part.Parent then
                part.Size = data.Size
                part.Transparency = data.Transparency
                part.CanCollide = data.CanCollide
                removeBox(part)
            end
            hitboxData[part] = nil
        end
    end
end

-- ========== ESP MODULE ==========
local function applyESP(npc)
    local head = npc:FindFirstChild("Head")
    if not head then return end
    local old = head:FindFirstChild("MBAA_ESP")
    if old then old:Destroy() end
    if not Config.ESPEnabled then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "MBAA_ESP"
    bb.Adornee = head
    bb.Size = UDim2.new(0, Config.ESPNameW, 0, Config.ESPNameH)
    bb.StudsOffset = Vector3.new(0, Config.ESPOffsetY, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = npc.Name
    lbl.TextColor3 = Config.ESPTextColor
    lbl.TextStrokeColor3 = Config.ESPStrokeColor
    lbl.TextStrokeTransparency = 0
    lbl.Font = Enum.Font.GothamBold
    lbl.TextScaled = Config.ESPTextScaled
    if not Config.ESPTextScaled then
        lbl.TextSize = Config.ESPTextSize
    end
    lbl.Parent = bb
end

local function refreshESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then applyESP(obj) end
    end
end

local function clearESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local head = obj:FindFirstChild("Head")
            if head then
                local tag = head:FindFirstChild("MBAA_ESP")
                if tag then tag:Destroy() end
            end
        end
    end
end

-- ========== AIMBOT ==========
local function getClosestNPC()
    local closest, best = nil, Config.AimbotFOV
    local center = Camera.ViewportSize / 2
    for npc in pairs(npcCache) do
        if isNPC(npc) then
            local part = npc:FindFirstChild(Config.AimbotPart)
            if part then
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < best then best = d; closest = part end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if not Config.AimbotEnabled or not aimbotActive then return end
    local t = getClosestNPC()
    if t then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, t.Position), Config.AimbotSmoothness)
    end
end)

UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Config.AimbotKey then aimbotActive = true end
end)
UserInputService.InputEnded:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Config.AimbotKey then aimbotActive = false end
end)


local PRESETS = {
    Color3.fromRGB(255,255,255), Color3.fromRGB(255,80,80), Color3.fromRGB(80,255,80),
    Color3.fromRGB(80,150,255), Color3.fromRGB(255,255,80), Color3.fromRGB(255,100,255),

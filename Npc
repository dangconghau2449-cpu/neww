local function makeColorCycle(parent, labelText, getValue, setValue, order)
    local frame = new("Frame", {Size = UDim2.new(1,0,0,34), BackgroundColor3 = Color3.fromRGB(35,35,48), BorderSizePixel = 0, LayoutOrder = order}, parent)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0,6)
    new("TextLabel", {Size = UDim2.new(0.5,-10,1,0), Position = UDim2.new(0,10,0,0), BackgroundTransparency = 1,
        Text = labelText, TextColor3 = Color3.fromRGB(220,220,240), Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left}, frame)
    local btn = new("TextButton", {Size = UDim2.new(0.5,-20,0,22), Position = UDim2.new(0.5,10,0.5,-11),
        BackgroundColor3 = getValue(), Text = "", BorderSizePixel = 0}, frame)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,4)
    local stroke = Instance.new("UIStroke", btn); stroke.Thickness = 1; stroke.Color = Color3.fromRGB(120,120,140)
    local idx = 1
    for i, c in ipairs(PRESETS) do
        if c.R == getValue().R and c.G == getValue().G and c.B == getValue().B then idx = i break end
    end
    btn.MouseButton1Click:Connect(function()
        idx = (idx % #PRESETS) + 1

-- ========== TOGGLE MENU KEY ==========
UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then
        menu.Visible = not menu.Visible
    end
end)

-- ========== MAIN LOOPS ==========
task.spawn(function()
    while menuGui.Parent do
        pcall(rebuildNPCCache)
        task.wait(0.5)
    end
end)

task.spawn(function()
    while menuGui.Parent do
        if Config.HitboxEnabled then pcall(applyHitbox) end
        task.wait(0.25)
    end
end)

task.spawn(function()
    while menuGui.Parent do
        if Config.ESPEnabled then pcall(refreshESP) end
        task.wait(1.5)
    end
end)

workspace.DescendantAdded:Connect(function(d)
    task.wait(0.2)
    if isNPC(d) then
        if Config.ESPEnabled then applyESP(d) end
        if Config.HitboxEnabled then pcall(applyHitbox) end
    end
end)

task.wait(1)
if Config.ESPEnabled then refreshESP() end
print("[MBAA v3] Menu đã load! RightShift bật/tắt menu. Bấm × để thu nhỏ thành nút ⚔.")

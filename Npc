    Size = UDim2.new(1,-20,1,-100), Position = UDim2.new(0,10,0,92),
    BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
    ScrollBarImageColor3 = Color3.fromRGB(100,100,150),
    CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.Never,
}, menu)

for i, key in ipairs(tabNames) do
    local btn = new("TextButton", {
        Size = UDim2.new(1/#tabNames-0.01,0,1,0), Position = UDim2.new((i-1)/#tabNames,0,0,0),
        BackgroundColor3 = Color3.fromRGB(42,42,60), Text = tabLabels[key],
        TextColor3 = Color3.fromRGB(190,190,220),
        Font = Enum.Font.GothamBold, TextSize = 12, BorderSizePixel = 0,
    }, tabBar)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    tabButtons[key] = btn

    local page = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = (i == 1),
    }, content)
    local ll = Instance.new("UIListLayout", page)
    ll.Padding = UDim.new(0,6); ll.SortOrder = Enum.SortOrder.LayoutOrder
    local pad = Instance.new("UIPadding", page)
    pad.PaddingTop = UDim.new(0,4); pad.PaddingBottom = UDim.new(0,8)
    tabContents[key] = page

    btn.MouseButton1Click:Connect(function()
        for n, p in pairs(tabContents) do p.Visible = (n == key) end
        for n, b in pairs(tabButtons) do
            b.BackgroundColor3 = (n == key) and Color3.fromRGB(70,70,120) or Color3.fromRGB(42,42,60)
        end
    end)
end
tabButtons["Hitbox"].BackgroundColor3 = Color3.fromRGB(70,70,120)

local orderCounters = {Hitbox=0, ESP=0, ESPLine=0, Aimbot=0}

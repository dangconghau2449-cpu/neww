local function new(cls, props, parent)
    local i = Instance.new(cls)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then pcall(function() i[k] = v end) end
    end
    if parent then i.Parent = parent end
    return i
end

local function makeToggle(parent, labelText, getValue, setValue, order)
    local frame = new("Frame", {Size = UDim2.new(1,0,0,34), BackgroundColor3 = Color3.fromRGB(35,35,48), BorderSizePixel = 0, LayoutOrder = order}, parent)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0,6)
    new("TextLabel", {Size = UDim2.new(1,-60,1,0), Position = UDim2.new(0,10,0,0), BackgroundTransparency = 1,
        Text = labelText, TextColor3 = Color3.fromRGB(220,220,240), Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left}, frame)
    local btn = new("TextButton", {Size = UDim2.new(0,44,0,22), Position = UDim2.new(1,-54,0.5,-11),
        BorderSizePixel = 0, Text = "", AutoButtonColor = false}, frame)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,11)
    local knob = new("Frame", {Size = UDim2.new(0,18,0,18), Position = UDim2.new(0,2,0.5,-9), BorderSizePixel = 0}, btn)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0,9)
    local function upd()
        local on = getValue()
        btn.BackgroundColor3 = on and Color3.fromRGB(70,180,110) or Color3.fromRGB(70,70,90)
        knob.BackgroundColor3 = on and Color3.fromRGB(230,255,240) or Color3.fromRGB(180,180,200)
        TweenService:Create(knob, TweenInfo.new(0.15), {Position = on and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)}):Play()
    end
    upd()
    btn.MouseButton1Click:Connect(function() setValue(not getValue()); upd() end)
    return frame
end

local function makeSlider(parent, labelText, minV, maxV, getValue, setValue, order, isInt)
    local frame = new("Frame", {Size = UDim2.new(1,0,0,50), BackgroundColor3 = Color3.fromRGB(35,35,48), BorderSizePixel = 0, LayoutOrder = order}, parent)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0,6)
    new("TextLabel", {Size = UDim2.new(0.6,-10,0,20), Position = UDim2.new(0,10,0,4), BackgroundTransparency = 1,
        Text = labelText, TextColor3 = Color3.fromRGB(220,220,240), Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left}, frame)
    local valLbl = new("TextLabel", {Size = UDim2.new(0.4,-10,0,20), Position = UDim2.new(0.6,0,0,4), BackgroundTransparency = 1,
        TextColor3 = Color3.fromRGB(150,200,255), Font = Enum.Font.GothamBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right}, frame)
    valLbl.Text = tostring(getValue())
    local bar = new("Frame", {Size = UDim2.new(1,-20,0,6), Position = UDim2.new(0,10,0,32),
        BackgroundColor3 = Color3.fromRGB(60,60,80), BorderSizePixel = 0}, frame)
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0,3)
    local fill = new("Frame", {Size = UDim2.new((getValue()-minV)/(maxV-minV),0,1,0),
        BackgroundColor3 = Color3.fromRGB(100,150,255), BorderSizePixel = 0}, bar)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,3)
    local hit = new("TextButton", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = ""}, bar)
    local dragging = false
    local function setFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = minV + (maxV-minV)*rel
        if isInt then val = math.floor(val+0.5) end
        setValue(val)
        fill.Size = UDim2.new(rel,0,1,0)
        valLbl.Text = isInt and tostring(math.floor(val+0.5)) or string.format("%.2f", val)
    end
    hit.MouseButton1Down:Connect(function()
        dragging = true
        setFromX(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    return frame
end


-- ========== ESP LINE MODULE ==========
local espLineGui = Instance.new("ScreenGui")
espLineGui.Name = "MBAA_ESPLines"
espLineGui.IgnoreGuiInset = true
espLineGui.ResetOnSpawn = false
espLineGui.DisplayOrder = 4
espLineGui.Parent = pg

local espLines = {}

local function destroyAllLines()
    for _, f in pairs(espLines) do f:Destroy() end
    espLines = {}
end

local function updateESPLinesSafe()
    if not Config.ESPLineEnabled then
        if next(espLines) then destroyAllLines() end
        return
    end

    for npc, frame in pairs(espLines) do
        if not npc.Parent or not isNPC(npc) then
            frame:Destroy(); espLines[npc] = nil
        end
    end

    local vs = Camera.ViewportSize
    local startPt = Vector2.new(vs.X / 2, vs.Y)

    for npc in pairs(npcCache) do
        if isNPC(npc) then
            local head = npc:FindFirstChild("Head") or npc:FindFirstChild("HumanoidRootPart")
            if head then
                local sp, on = Camera:WorldToViewportPoint(head.Position)
                if on and sp.Z > 0 then
                    local frame = espLines[npc]
                    if not frame then
                        frame = Instance.new("Frame")
                        frame.AnchorPoint = Vector2.new(0, 0.5)
                        frame.BorderSizePixel = 0
                        frame.Parent = espLineGui
                        espLines[npc] = frame
                    end
                    local delta = Vector2.new(sp.X, sp.Y) - startPt
                    frame.Position = UDim2.fromOffset(startPt.X, startPt.Y)
                    frame.Size = UDim2.fromOffset(delta.Magnitude, Config.ESPLineThickness)
                    frame.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                    frame.BackgroundColor3 = Config.ESPLineColor
                    frame.Visible = true
                elseif espLines[npc] then
                    espLines[npc].Visible = false
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    pcall(updateESPLinesSafe)
end)

